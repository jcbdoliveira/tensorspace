import requests

# URL pública fornecida pelo Render após o deploy
url_render = "https://tensorspace.onrender.com/"

# Caminho do seu modelo local em Python 3.11
caminho_modelo = "model.weights.h5"
camadas_alvo = "conv_1,maxpool_1,flatten,saida"

print("Enviando modelo para conversão no Render...")

# Prepara o arquivo e os parâmetros para envio via POST
with open(caminho_modelo, "rb") as f:
    arquivos = {"model": f}
    dados = {"layers": camadas_alvo}
    
    resposta = requests.post(url_render, files=arquivos, data=dados)

# Se a conversão deu certo, o Render devolve um arquivo .zip
if resposta.status_code == 200:
    with open("resultado_tensorspace.zip", "wb") as saida:
        saida.write(resposta.content)
    print("Sucesso! Arquivo 'resultado_tensorspace.zip' salvo localmente.")
else:
    print("Falha na conversão:")
    print(resposta.text)
